# ===========================================================
#  קובץ דוגמה למשתני סביבה — "צוות הסוכנים"
#  העתק קובץ זה ל-.env ומלא ערכים אמיתיים. אל תעלה את .env לגיט!
#    cp .env.example .env        (Linux/Mac)
#    Copy-Item .env.example .env (PowerShell)
# ===========================================================

# --- Anthropic / Claude — הבסיס להרצת הצוות (ראובן והסוכנים) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# --- יצירת תמונות — יובל, מעצב התמונות ---
# מפתח לשירות יצירת/עיבוד תמונות (לדוגמה OpenAI)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGE_MODEL=gpt-image-1

# --- חיפוש ומחקר — חן, החוקרת ---
# מפתח API לשירות חיפוש (Tavily / Brave / Google וכו')
SEARCH_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- הגדרות כלליות ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
